[Unit]
Description=Piso WiFi API
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/pisowifi/backend
EnvironmentFile=/etc/pisowifi/app.env
ExecStart=/opt/pisowifi/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
